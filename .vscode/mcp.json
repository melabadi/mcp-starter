{
  "servers": {
    "azure-devops": {
      "type": "http",
      "url": "https://mcp.dev.azure.com/${input:adoOrganization}",
      "headers": {
        "X-MCP-Readonly": "true",
        "X-MCP-Tools": "core_list_projects,wit_work_item,repo_pull_request"
      }
    },
    "onenote-local": {
      "type": "stdio",
      "command": "node",
      "args": ["${workspaceFolder}\\src\\onenote-stdio.ts"],
      "env": {
        "ONENOTE_BACKEND": "com",
        "ONENOTE_ALLOWED_NOTEBOOK_IDS": "${input:oneNoteNotebookIds}"
      }
    }
  },
  "inputs": [
    {
      "id": "adoOrganization",
      "type": "promptString",
      "description": "Your Entra-backed Azure DevOps organization name, not a project or URL"
    },
    {
      "id": "oneNoteNotebookIds",
      "type": "promptString",
      "description": "JSON array of approved local OneNote COM notebook IDs from .local\\onenote-demo.json"
    }
  ]
}