{
  "name": "mcp-setup",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "test:registry": "node --test tests/registry.test.ts",
    "test:server": "node --test tests/server.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "node src/main.ts server",
    "start:registry": "node src/main.ts registry",
    "start:stdio": "node src/stdio.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "typescript": "7.0.2"
  }
}
